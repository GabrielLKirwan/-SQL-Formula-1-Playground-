-- Pit Stop Delta (Window Functions): Calculate the difference in time (in MILLISECONDS) between a driver's first pit stop and their second pit stop for every driver in RACEID = 1110.


select 
  driverid
  ,stop
  ,milliseconds
  ,lead(milliseconds) over (
      partition by driverid
      order by stop asc 
      ) as next_ps
  ,(milliseconds-lead(milliseconds) over (
      partition by driverid
      order by stop asc 
      )) as time_difference
from til_playground.f1.pit_stops
    where raceid = 1077
    and stop = 1 or 2

