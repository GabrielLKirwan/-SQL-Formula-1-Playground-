-- Season Point Progression (CTE + Running Total): Create a CTE that calculates the total points earned by each Constructor per race. In the main query, use a window function to show a running total of those points across the 2023 season.

with q1 as (
select
    re.constructorid
    ,re.raceid
    ,sum(points) as total_points
from til_playground.f1.results as re
    group by re.constructorid,re.raceid
)

select 
    constructorid
    ,raceid
    ,total_points
    ,sum(total_points) over (
    partition by constructorid
    order by raceid asc) as running_total_points

from q1 
