-- The "Top 10" Club: Join DRIVERS and RESULTS to find the total number of times each driver has finished in the top 10 (where POSITION is between 1 and 10). Return the driver's full name and their count.

select 
  dr.forename
  ,dr.surname
  ,re.position
  ,count(position) as top_ten_times

from til_playground.f1.results as re
    left join til_playground.f1.drivers as dr
        on re.driverid = dr.driverid
  where re.position <= 10
  group by dr.forename,DR.SURNAME,re.position
  order by top_ten_times desc







;
-- Circuit Popularity: Identify which COUNTRY has hosted the most races. 

select 
  country
  ,count(country) as country_count
from til_playground.f1.circuits as ci
    left join til_playground.f1.races as ra 
        on ci.circuitid = ra.circuitid
  group by country
  order by country_count desc



