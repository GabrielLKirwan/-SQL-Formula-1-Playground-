-- Easy Questions
-- Target: 30–60 seconds per question.

-- Grand Prix Calendar: Select the NAME, DATE, and URL of all races held in the year 2023, ordered by the ROUND number.

select 
name
,round
,date
,url
from til_playground.f1.races
where year = 2022
order by round asc


;
-- Driver Nationalities: Find the total number of unique NATIONALITY values present in the DRIVERS table.
select  
nationality
,count(nationality) as count
from til_playground.f1.drivers 
group by  nationality


;

-- Active Seasons: List all years from the SEASONS table in descending order (newest to oldest).

select
year
from til_playground.f1.seasons
order by year desc



;
-- Medium Questions
-- Target: 2–3 minutes per question. Focus: Joins and Grouping.

-- Circuit Locations: Join the RACES and CIRCUITS tables to list every race NAME from the 2023 season along with its corresponding circuit LOCATION and COUNTRY.
select
    ra.name 
    ,ra.circuitid
    ,ci.location
    ,ci.country
from til_playground.f1.races as ra 
    left join til_playground.f1.circuits as ci
        on ra.circuitid = ci.circuitid
    where year = 2022



;
-- Point Scorers: Find the top 10 drivers who have earned the most career POINTS (from the RESULTS table). Return their FORENAME, SURNAME, and the sum of their points.

select 
dr.forename 
    ,dr.surname 
    ,sum(re.points) as total_points
    

from til_playground.f1.results as re
    left join til_playground.f1.drivers as dr 
        on re.driverid = dr.driverid 
group by dr.forename,dr.surname
order by total_points desc
limit 10 


