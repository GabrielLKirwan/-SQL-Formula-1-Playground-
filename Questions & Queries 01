-- Hard Questions
-- Target: 3–4 minutes per question. Focus: Window Functions and CTEs.

-- The Lap Time Delta: For a specific race (e.g., RACEID = 1100), use a Window Function to show each driver's lap time (MILLISECONDS) alongside the time of the previous lap they completed. Calculate the difference between the two.
;
with q1 as (

select 
driverid
,lap
,milliseconds
,lag(milliseconds) over (
    partition by driverid
    order by lap asc) as prev_time
from til_playground.f1.lap_times
where raceid=1094)

select 
driverid
,lap
,milliseconds
,prev_time
,(prev_time-milliseconds) as difference 
from q1 




-- Logic: Use LAG() OVER(PARTITION BY driverId ORDER BY lap).

-- Consistency Ranking: Use a CTE to calculate the average pit stop DURATION for every driver in the 2023 season. In the main query, rank the drivers from 1 to 10 based on who has the fastest average stops.
;

with q1 as (
select 
driverid
avg(duration) as avg_ps
from til_playground.f1.pit_stops
) 

select 
driverid 
,avg_ps
from q1 
     v order by avg_ps desc  

